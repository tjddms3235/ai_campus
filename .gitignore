# 1) 기본적으로 모든 파일 무시
*

# 2) 폴더 안으로 들어가는 것은 허용
!*/

# 3) 저장소 관리 파일
!.gitignore
!README.md

# 4) 각 프로젝트 .srcs 안의 소스 파일만 허용
!**/*.srcs/**/*.v
!**/*.srcs/**/*.sv
!**/*.srcs/**/*.vh
!**/*.srcs/**/*.svh
!**/*.srcs/**/*.xdc
!**/*.srcs/**/*.xci
!**/*.srcs/**/*.mem
!**/*.srcs/**/*.coe

# 5) source 폴더는 전부 허용
!src/**
